# Security: generate independent random values; never commit the real file.
STUDY_TOKEN_SECRET=
STUDY_CODE_PEPPER=
STUDY_IP_PEPPER=
STUDY_ADMIN_TOKEN=
# `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
# Store the real value in a root/user-readable-only service environment file.
# Never reuse a token/pepper value and never print this key in logs.
COMPENSATION_VAULT_KEY=
# Base64url-encoded 32-byte Ed25519 private seed. Each instance must have an
# independent key; preserve it across deployments and never expose it.
CONSENT_EVIDENCE_SIGNING_KEY=

# Keep disabled until every readiness check and ethics requirement is satisfied.
FORMAL_STUDY_ENABLED=0
# Keep readiness visible in the admin audit while allowing the participant
# workflow to run when explicitly disabled for an isolated deployment.
FORMAL_READINESS_ENFORCED=1
APPROVED_CONSENT_VERSION=
PUBLIC_BASE_URL=http://127.0.0.1:8765

# Timing model. Use mock only for engineering pilots.
AGENT_MODE=mock
BASE_ENCODER_CHECKPOINT=./checkpoints/base_encoder.pth
BASE_MAIN_CHECKPOINT=./checkpoints/base_main_model.pth
MATCHED_ENCODER_CHECKPOINT=./checkpoints/matched_encoder.pth
MATCHED_MAIN_CHECKPOINT=./checkpoints/matched_main_model.pth
MATCHED_MODEL_MANIFEST=./data/matched-model-manifest.json
MATCHED_MODEL_READY_SENTINEL=./data/matched-model-self-test.json
MODEL_READY_SENTINEL=./data/model-self-test.json
MODEL_CODE_DIR=./model_code

# DistilHuBERT is the acoustic timing backend used by the study.
# Set AGENT_MODE=distilhubert only after producing a hash-locked release manifest.
# Runtime is local-cache-only unless the explicit download switch is enabled.
DISTILHUBERT_RELEASE_MANIFEST=
DISTILHUBERT_CACHE_DIR=./.cache/huggingface/hub
DISTILHUBERT_ALLOW_DOWNLOAD=0
DISTILHUBERT_DEVICE=cpu

# Browser recognition is the low-latency first path. Short 16 kHz PCM is kept
# only in memory and sent to server Whisper when browser recognition is empty.
ASR_MODE=browser
SERVER_ASR_ENABLED=1
SERVER_ASR_MODEL=large-v3
SERVER_ASR_DEVICE=cuda:0
SERVER_ASR_DOWNLOAD_ROOT=./.cache/whisper
SERVER_ASR_MAX_SECONDS=15
# Prevent Whisper hallucinations on digital silence. This is not an activation
# gate: an already-triggered turn still responds with an explicit repeat request.
SERVER_ASR_MIN_RMS=0.001
# Independent addressee/reply-needed context gate. This model is kept separate
# from the acoustic speaker/personalisation head.
REPLY_NEEDED_MODEL=./private/reply-needed-context-v4-candidate/reply_needed_model.json

# Supply service credentials locally; keep them out of version control.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=z-ai/glm-5.2
LLM_PROVIDER_ORDER=z-ai
LLM_ALLOW_FALLBACKS=false
LLM_REASONING_ENABLED=false

# Recommended locked server-side TTS for v6. Download the AISHELL3 VITS model
# named below and run the public TTS smoke test before releasing a wave.
# All 34 roles use mutually exclusive local AISHELL-3 speakers. The two agent
# IDs are chosen by scripts/select_local_agent_voices.py and locked before a run.
TTS_MODE=sherpa_onnx
SHERPA_TTS_MODEL_DIR=./data/tts/vits-icefall-zh-aishell3
SHERPA_TTS_SPEAKER_ID=116
SHERPA_TTS_PRIMARY_SPEAKER_ID=116
SHERPA_TTS_COMPANION_SPEAKER_ID=92
SHERPA_TTS_SPEED=0.94
SHERPA_TTS_NUM_THREADS=4
FFMPEG_BINARY=/usr/bin/ffmpeg
TTS_READY_SENTINEL=./data/tts-self-test.json

# Retained only for legacy runs that explicitly lock TTS_MODE=xunfei.
XUNFEI_APP_ID=
XUNFEI_API_KEY=
XUNFEI_API_SECRET=
XUNFEI_VOICE=aisjinger
XUNFEI_PRIMARY_VOICE=aisjinger
XUNFEI_COMPANION_VOICE=aisjiuxu

STUDY_DATA_DIR=./data
STUDY_MEDIA_DIR=./data/media
BACKGROUND_MANIFEST=./content/background_manifest.json
MAX_AUDIO_UPLOAD_BYTES=26214400
# Optional minimal cross-instance Share-fit scheduling mutex. Both formal and
# test may point at the same SQLite file; it stores no participant raw IDs,
# study records, models, questionnaire answers, audio or conversation text.
SHARE_GLOBAL_COORDINATION_PATH=

# The versioned server-side protocol is content/study_protocol.json. Formal runs always
# use strict mode; pilot/simulation runs may use compressed mode for engineering checks.
